{
  "name": "coding-mistakes-3d-short",
  "version": "1.0.0",
  "private": true,
  "description": "5 Beginner Coding Mistakes That Cost Me Hours. A 47 second vertical 3D short rendered with Remotion and React Three Fiber.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "gen-audio": "node scripts/generate-audio.ts",
    "voice:prepare": "esbuild scripts/prepare-voice.ts --bundle --platform=node --format=cjs --outfile=out/checks/prepare-voice.cjs --log-level=warning && node out/checks/prepare-voice.cjs",
    "voice:prepare:report": "esbuild scripts/prepare-voice.ts --bundle --platform=node --format=cjs --outfile=out/checks/prepare-voice.cjs --log-level=warning && node out/checks/prepare-voice.cjs --allow-overflow",
    "check:black": "node scripts/check-black-frames.ts",
    "check:safety": "esbuild scripts/check-frame-safety.ts --bundle --platform=node --format=cjs --outfile=out/checks/frame-safety.cjs --external:three --external:remotion --external:react --external:react-dom --external:@remotion/noise --external:three-stdlib --log-level=warning && node out/checks/frame-safety.cjs",
    "check:captions": "esbuild scripts/check-caption-fit.ts --bundle --platform=node --format=cjs --outfile=out/checks/caption-fit.cjs --external:three --external:three-stdlib --log-level=warning && node out/checks/caption-fit.cjs",
    "check": "npm run check:safety && npm run check:captions",
    "stills:frames": "node scripts/still-frames.ts",
    "verify:stills": "bash scripts/verify-stills.sh",
    "render:preview": "npm run gen-audio && npm run voice:prepare && remotion render src/index.ts CodingMistakes3D out/preview.mp4 --gl=angle --concurrency=2 --scale=0.5 --props=props/preview.json",
    "render:final": "npm run gen-audio && npm run voice:prepare && remotion render src/index.ts CodingMistakes3D out/final.mp4 --gl=angle --concurrency=1 --scale=1.5 --crf=16 --props=props/final.json",
    "render:segments": "bash scripts/render-segments.sh"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/cli": "4.0.542",
    "@remotion/media-utils": "4.0.542",
    "@remotion/motion-blur": "4.0.542",
    "@remotion/noise": "4.0.542",
    "@remotion/three": "4.0.542",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
