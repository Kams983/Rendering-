{
  "name": "why-you-cant-stop-scrolling",
  "version": "1.0.0",
  "private": true,
  "description": "A 64 second vertical 3D product film about the infinite scroll loop.",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "typecheck": "tsc --noEmit",
    "sfx": "python scripts/generate_sfx.py",
    "render:video": "remotion render src/index.ts WhyYouCantStopScrolling out/video-silent.mp4 --muted --gl=swangle --props=props/final.json",
    "render:sfx": "remotion render src/index.ts StopScrollingSfx out/sfx.wav --codec=wav --gl=swangle",
    "render:full": "remotion render src/index.ts WhyYouCantStopScrolling out/preview-with-sfx.mp4 --gl=swangle --props=props/final.json",
    "render:draft": "remotion render src/index.ts WhyYouCantStopScrolling out/draft.mp4 --muted --gl=swangle --props=props/draft.json",
    "render:final": "remotion render src/index.ts WhyYouCantStopScrolling out/final.mp4 --gl=swangle --props=props/final.json"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@remotion/cli": "4.0.542",
    "@remotion/three": "4.0.542",
    "postprocessing": "6.39.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.542",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "typescript": "7.0.2"
  }
}
