{
  "name": "you-are-not-behind",
  "version": "1.0.0",
  "private": true,
  "description": "New York Wasn't Always New York: a 3D animated history of Manhattan",
  "scripts": {
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts NewYorkHistory out/new-york.mp4 --gl=angle",
    "render:ci": "remotion render src/index.ts NewYorkHistory out/new-york.mp4 --gl=swangle",
    "still": "remotion still src/index.ts NewYorkHistory out/frame.png --frame=900 --gl=angle",
    "sfx": "python scripts/generate_sfx.py",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.542",
    "@remotion/three": "4.0.542",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "remotion": "4.0.542",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2"
  }
}
